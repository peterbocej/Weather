{
   "Logging": {
      "LogLevel": {
         "Default": "Information",
         "Microsoft.AspNetCore": "Warning"
      }
   },
   "AllowedHosts": "*",
   "ConnectionStrings": {
      "WeatherCache": "Data Source=Data/WeatherCache.db",
      "Security": "Data Source=Data/Security.db"
   },
   "AppSettings": {
      "WeatherApiServer": {
         "Url": "https://api.weatherapi.com/v1/current.json?key={0}&q={1}&aqi=no",
         "ApiKey": "{API_KEY}"
      },
      "Jwt": {
         "Key": "{SECRET_KEY}",
         "Issuer": "https://localhost",
         "Audience": "https://localhost",
         "DurationInMinutes": 60
      },
      "Cache": {
         "Mode": "Database" // "None", "Memory" or "Database"
      },
      "Cities": [
         {
            "Id": 1,
            "Name": "Bratislava"
         },
         {
            "Id": 2,
            "Name": "Praha"
         },
         {
            "Id": 3,
            "Name": "Budapest"
         },
         {
            "Id": 4,
            "Name": "Vienna"
         }
      ]
   }
}
